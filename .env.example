# Lifeline environment catalog (backlog §4). Values stay empty here.
# Private keys and tokens belong in gitignored secrets/ or platform secret stores.

# §4.1 secrets/testnet-keys.env — testnet role keys. Never commit.
SPONSOR_PK=
POOL_OWNER_PK=
OPERATOR_PK=
MAKER_PK=
CALIBRATION_PK=
TEST_OWNER_PK=

# §4.2 secrets/services.env — human-filled, plus agent-generated ADMIN_SECRET and RADAR_SALT.
ENVIO_API_TOKEN=
PRIVY_APP_ID=
PRIVY_CLIENT_ID=
PRIVY_VERIFICATION_KEY=
ALCHEMY_MONAD_MAINNET_URL=
ALCHEMY_MONAD_TESTNET_URL=
ADMIN_SECRET=
RADAR_SALT=

# §4.3 Worker secrets (wrangler) and Vercel env.
# Comma-separated HTTPS URLs. Public defaults live in @lifeline/core; these override or extend them.
RPC_URLS_MAINNET=
RPC_URLS_TESTNET=
# Kill switch. "true" disables operator sends. Reads still work.
LIFELINE_PAUSED=
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
NEXT_PUBLIC_WORKER_URL=
WORKER_HEALTH_URL=

# §3 Playwright base. Defaults to http://localhost:3000.
E2E_BASE_URL=
